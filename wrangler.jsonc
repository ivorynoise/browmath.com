{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "browmath-com",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "browmath.com", "custom_domain": true },
    { "pattern": "www.browmath.com", "custom_domain": true }
  ]
}
